@model MssqlLocks.Observer.Models.MonitoringDashboardViewModel

@{
    ViewData["Title"] = "Monitoring overview";
}

<div class="py-4">
    <div class="mb-4">
        <p class="text-uppercase text-muted small fw-semibold mb-2">Production SQL Server observability</p>
        <h1 class="display-5 fw-semibold">Monitoring overview</h1>
        <p class="lead text-muted mb-0">
            A read-only investigation surface for correlating SQL Server and .NET telemetry.
        </p>
    </div>

    <div class="alert alert-warning" role="alert">
        <strong>Data source:</strong> @Model.DataSourceStatus.
        Collectors are not connected yet. This page is the safe foundation for the monitoring adapters.
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h6 text-muted">Application</h2>
                    <p class="h4 mb-0">@Model.ApplicationName</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h6 text-muted">Collection mode</h2>
                    <p class="h4 mb-0">@Model.CollectionMode</p>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h4 mb-3">Investigation capabilities</h2>
    <div class="row g-3">
        @foreach (var capability in Model.Capabilities)
        {
            <div class="col-lg-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-3">
                            <h3 class="h5">@capability.Name</h3>
                            <span class="badge text-bg-secondary">@capability.Status</span>
                        </div>
                        <p class="small text-muted mb-2">Source: @capability.Source</p>
                        <p class="mb-0">@capability.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
