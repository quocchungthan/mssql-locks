@model MssqlLocks.Web.Models.WatchDashboardViewModel

@{
    ViewData["Title"] = "SQL Diagnostics";
}

<section class="dashboard" aria-labelledby="page-title">
    <header class="dashboard-heading">
        <div>
            <p class="eyebrow">READ-ONLY / SQL SERVER</p>
            <h1 id="page-title">Diagnostics</h1>
            <p class="lede">Run a report or start a live monitor when needed.</p>
        </div>
    </header>

    <section class="report-explorer" aria-labelledby="report-explorer-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">REPORT COMMANDS</p>
                <h2 id="report-explorer-title">Run a report</h2>
            </div>
            <span class="result-count">@Model.Categories.Sum(category => category.Reports.Count) reports</span>
        </div>
        <form asp-controller="Home" asp-action="RunReport" method="post" class="report-form" id="report-form">
            @Html.AntiForgeryToken()
            <label for="report-category">Category</label>
            <select id="report-category" name="category">
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Name" selected="@(category.Name == Model.SelectedCategory)">@category.Label</option>
                }
            </select>
            <label for="report-name">Report</label>
            <select id="report-name" name="reportName">
                @foreach (var category in Model.Categories)
                {
                    foreach (var report in category.Reports)
                    {
                        <option value="@report.FileName" data-category="@category.Name" selected="@(category.Name == Model.SelectedCategory && report.FileName == Model.SelectedReport)">@report.FileName</option>
                    }
                }
            </select>
            <button class="button button-start" type="submit">Run report</button>
        </form>
        <p class="table-note">Results are rendered as text and limited to 250 displayed rows. Query and server details may be present in report output.</p>

        @if (Model.ReportError is not null)
        {
            <p class="report-error" role="alert">@Model.ReportError</p>
        }
        @if (Model.ReportResult is not null)
        {
            <div class="report-result">
                <div class="results-heading">
                    <h3>@Model.SelectedReport</h3>
                    <span class="result-count">@Model.ReportResult.TotalRows rows / @Model.ReportResult.Elapsed.TotalMilliseconds.ToString("N0") ms</span>
                </div>
                <div class="table-scroll" role="region" aria-label="Report results" tabindex="0">
                    <table>
                        <thead>
                            <tr>
                                @foreach (var column in Model.ReportResult.Columns)
                                {
                                    <th scope="col">@column</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ReportResult.Rows)
                            {
                                <tr>
                                    @foreach (var value in row)
                                    {
                                        <td>@(value ?? "NULL")</td>
                                    }
                                </tr>
                            }
                            @if (Model.ReportResult.Rows.Count == 0)
                            {
                                <tr class="empty-row"><td colspan="@Math.Max(Model.ReportResult.Columns.Count, 1)">No rows returned.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.ReportResult.IsTruncated)
                {
                    <p class="table-note">Showing the first @Model.ReportResult.Rows.Count rows.</p>
                }
            </div>
        }
    </section>

    <section class="live-monitors" aria-labelledby="live-monitors-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">LIVE COMMANDS</p>
                <h2 id="live-monitors-title">Monitors</h2>
            </div>
        </div>

        <div class="monitor-grid">
            <article class="monitor-tool" aria-labelledby="capacity-title">
                <div class="monitor-heading">
                    <div>
                        <h3 id="capacity-title">Live capacity</h3>
                        <p id="capacity-message">@Model.CapacityStatus.Message</p>
                    </div>
                    <span class="state-chip" id="capacity-state" data-state="@Model.CapacityStatus.State.ToLowerInvariant()">@Model.CapacityStatus.State</span>
                </div>
                <div class="monitor-controls">
                    <form asp-controller="Watch" asp-action="StartCapacity" method="post" id="capacity-start-form" hidden="@Model.CapacityStatus.IsRunning">
                        @Html.AntiForgeryToken()
                        <button class="button button-start" type="submit">Start one-second monitor</button>
                    </form>
                    <form asp-controller="Watch" asp-action="StopCapacity" method="post" id="capacity-stop-form" hidden="@(!Model.CapacityStatus.IsRunning)">
                        @Html.AntiForgeryToken()
                        <button class="button button-stop" type="submit">Stop monitor</button>
                    </form>
                    <span class="result-count" id="capacity-time">@(Model.CapacitySnapshot?.CapturedAt.ToLocalTime().ToString("HH:mm:ss") ?? "No sample yet")</span>
                </div>
                <div class="table-scroll compact-table" role="region" aria-label="Capacity monitor values" tabindex="0">
                    <table>
                        <thead id="capacity-head">
                            @if (Model.CapacitySnapshot is not null)
                            {
                                <tr>
                                    @foreach (var column in Model.CapacitySnapshot.Columns)
                                    {
                                        <th scope="col">@column</th>
                                    }
                                </tr>
                            }
                        </thead>
                        <tbody id="capacity-body">
                            @if (Model.CapacitySnapshot is not null)
                            {
                                <tr>
                                    @foreach (var value in Model.CapacitySnapshot.Values)
                                    {
                                        <td>@(value ?? "NULL")</td>
                                    }
                                </tr>
                            }
                            else
                            {
                                <tr class="empty-row"><td colspan="4">Start the monitor to capture capacity.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>

            <article class="monitor-tool" aria-labelledby="memory-grants-title">
                <div class="monitor-heading">
                    <div>
                        <h3 id="memory-grants-title">Memory grants</h3>
                        <p id="memory-grants-message">@Model.MemoryGrantsStatus.Message</p>
                    </div>
                    <span class="state-chip" id="memory-grants-state" data-state="@Model.MemoryGrantsStatus.State.ToLowerInvariant()">@Model.MemoryGrantsStatus.State</span>
                </div>
                <div class="monitor-controls">
                    <form asp-controller="Watch" asp-action="Start" method="post" id="memory-grants-start-form" class="watch-form" hidden="@Model.MemoryGrantsStatus.IsRunning">
                        @Html.AntiForgeryToken()
                        <label for="interval-seconds">Refresh seconds</label>
                        <input id="interval-seconds" name="intervalSeconds" type="number" min="1" max="2147483647" step="1" value="@Model.MemoryGrantsStatus.IntervalSeconds" required />
                        <button class="button button-start" type="submit">Start watch</button>
                    </form>
                    <form asp-controller="Watch" asp-action="Stop" method="post" id="memory-grants-stop-form" hidden="@(!Model.MemoryGrantsStatus.IsRunning)">
                        @Html.AntiForgeryToken()
                        <button class="button button-stop" type="submit">Stop watch</button>
                    </form>
                    <span class="result-count" id="memory-grants-time">@(Model.MemoryGrantsSnapshot?.CapturedAt.ToLocalTime().ToString("HH:mm:ss") ?? "No sample yet")</span>
                </div>
                <div class="metric-strip monitor-metrics" aria-label="Memory grant summary">
                    <div class="metric"><span class="metric-label">Waiting</span><strong id="waiting-count">@(Model.MemoryGrantsSnapshot?.WaitingCount ?? 0)</strong></div>
                    <div class="metric"><span class="metric-label">Granted</span><strong id="granted-count">@(Model.MemoryGrantsSnapshot?.GrantedCount ?? 0)</strong></div>
                    <div class="metric"><span class="metric-label">Rows</span><strong id="rows-count">@(Model.MemoryGrantsSnapshot?.TotalRows ?? 0)</strong></div>
                </div>
                <div class="table-scroll compact-table" role="region" aria-label="Memory grants values" tabindex="0">
                    <table>
                        <thead id="results-head">
                            @if (Model.MemoryGrantsSnapshot is not null)
                            {
                                <tr>
                                    @foreach (var column in Model.MemoryGrantsSnapshot.Columns)
                                    {
                                        <th scope="col">@column</th>
                                    }
                                </tr>
                            }
                        </thead>
                        <tbody id="results-body">
                            @if (Model.MemoryGrantsSnapshot is not null)
                            {
                                @foreach (var row in Model.MemoryGrantsSnapshot.Rows)
                                {
                                    <tr>
                                        @foreach (var value in row)
                                        {
                                            <td>@(value ?? "NULL")</td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="empty-row"><td colspan="8">Start the watch to capture memory grants.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="table-note">The live snapshot omits identity and query-text columns.</p>
            </article>
        </div>
    </section>
</section>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/memory-grants.js" asp-append-version="true"></script>
}
