<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - SQL Monitor</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="SQL Monitor home">
                <span class="brand-mark" aria-hidden="true">M</span>
                <span>SQL <b>MONITOR</b></span>
            </a>
            <span class="topbar-note" id="transport-state" aria-live="polite">LIVE CHANNEL CONNECTING</span>
        </header>
        <main>
            @RenderBody()
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
